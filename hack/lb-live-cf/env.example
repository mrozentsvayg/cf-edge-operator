# Copy to .env and fill in. .env is gitignored -- never commit a real token.
#
# Create a Cloudflare API token (My Profile -> API Tokens -> Create Token ->
# Custom token) with these permissions, scoped to the account and zone below:
#   Account > Load Balancing: Monitors and Pools > Edit
#   Account > Account Settings                    > Read   (Account CR init: accounts.Get)
#   Zone    > Load Balancers                       > Edit
#   Zone    > DNS                                  > Edit   (the LB hostname is a DNS record)
#   Zone    > Zone                                 > Read   (Zone CR init: zones.Get)
export CF_API_TOKEN=""

# 32-char hex account id (dashboard -> account home -> Account ID, or the API section).
export CF_ACCOUNT_ID=""

# 32-char hex zone id (zone overview -> API section).
export CF_ZONE_ID=""

# The zone's apex domain. Used to build LB and origin hostnames, e.g. example.com.
export CF_ZONE_NAME=""

# Optional overrides:
# export LBKIT_CONTEXT=kind-cf-lb             # kubeconfig context for kubectl + the operator; "" = current-context
# export LBKIT_NS=cf-edge-operator-system     # namespace for all kit resources
# export LBKIT_GO_BIN=/path/to/go/bin         # prepended to PATH if your go isn't there for `make`
# export CF_API=https://api.cloudflare.com/client/v4
# export LBKIT_PAUSE=1                         # pause the gates after each CF mutation so you can inspect the dashboard (blocks only on an interactive TTY); unset = never pause
